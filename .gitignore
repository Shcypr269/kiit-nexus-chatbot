# ============================================
# KIIT NEXUS Chatbot — .gitignore
# ============================================

# --- SECRET KEYS 
.env
.env.local
.env.production
*.env

# --- VIRTUAL ENVIRONMENT ---
venv/
nexus/
env/
.venv/
*.venv

# --- CHROMADB (local vector database) ---
# This is auto-generated by ingest.py — no need to push
chroma_db/

# --- PYTHON CACHE ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# --- HUGGINGFACE MODEL CACHE ---
# The embedding model downloads automatically — don't push it
.cache/
*.bin
*.safetensors

# --- STREAMLIT ---
.streamlit/secrets.toml

# --- JUPYTER NOTEBOOKS (if any) ---
.ipynb_checkpoints/
*.ipynb

# --- OS FILES ---
# Windows
Thumbs.db
desktop.ini
ehthumbs.db



# --- IDE & EDITOR FILES ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- LOGS ---
*.log
logs/
pip-log.txt

# --- BUILD / DIST ---
build/
dist/
*.egg-info/
.eggs/

# --- PYTEST ---
.pytest_cache/
htmlcov/
.coverage


# --- RAW PDFs (too large for GitHub) ---
# Keep data/processed/ — your cleaned txt files are fine to push
data/raw/